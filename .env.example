# ==============================================================
# Personal Laptop Face Guard - Environment Configuration
# ==============================================================

# Database Configuration (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=face_guard_db
DB_USER=postgres
DB_PASSWORD=password_rahasia

# Telegram Bot Alert Configuration
# Dapatkan BOT_TOKEN dari @BotFather dan CHAT_ID dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Camera & Recognition Parameters
CAMERA_INDEX=0
SIMILARITY_THRESHOLD=0.50

# State Machine Timers (in seconds)
INTRUDER_GRACE_SEC=3.0
SNOOPING_GRACE_SEC=2.0
AWAY_LOCK_SEC=30.0
IDLE_POLL_SEC=2.5

# Liveness & Anti-Spoofing
LIVENESS_ENABLED=true

# Alert & Audio
ENABLE_AUDIO_ALERT=true

